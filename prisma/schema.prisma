// SkillsProMax — data model (LOCAL DEV: SQLite)
//
// The production source of truth is prisma/schema.postgres.prisma (Postgres +
// native enums). This file is the SQLite mirror so the app runs locally with
// zero setup. Prisma does not support enums or scalar lists on SQLite, so
// enums are stored as String and StaffProfile.expertise as Json. The
// application code passes string literals for all of these, so it is
// provider-agnostic and works against either schema unchanged.
//
// To switch to Postgres for production:
//   cp prisma/schema.postgres.prisma prisma/schema.prisma
//   set DATABASE_URL to your Postgres connection string
//   npx prisma generate && npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/* ------------------------------------------------------------------ */
/* People                                                             */
/* ------------------------------------------------------------------ */

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         String    @default("STUDENT")
  gender       String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  studentProfile   StudentProfile?
  staffProfile     StaffProfile?
  assignedApps     Application[]      @relation("AssignedStaff")
  authoredNotes    ApplicationNote[]
  authoredPosts    Announcement[]
  verifiedPayments FeePayment[]       @relation("VerifiedBy")

  @@index([role])
}

model StudentProfile {
  id         String  @id @default(cuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNo     String  @unique
  cnic       String?
  fatherName String?
  address    String?
  city       String?
  whatsapp   String?

  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
}

model StaffProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  bio       String?
  /// What this person has actually shipped. We publish instructor credentials.
  expertise Json?
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  taughtBatches Batch[] @relation("BatchInstructor")
}

/* ------------------------------------------------------------------ */
/* Catalogue                                                          */
/* ------------------------------------------------------------------ */

model Course {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  audience    String
  summary     String
  outcome     String
  /// Deliberately-honest expectation setting. Shown publicly.
  honestNote  String?
  durationWks Int
  feeMonthly  Int
  feeMonths   Int
  entryReq    String?
  isPublished Boolean @default(false)
  sortOrder   Int     @default(0)

  modules Module[]
  batches Batch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Module {
  id        String @id @default(cuid())
  courseId  String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  body      String
  sortOrder Int    @default(0)

  @@index([courseId])
}

model Batch {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  name         String
  /// Boys and girls are taught in separate batches, always.
  gender       String
  timeSlot     String
  hall         String?
  startDate    DateTime
  endDate      DateTime?
  capacity     Int      @default(20)
  status       String   @default("PLANNED")
  instructorId String?
  instructor   StaffProfile? @relation("BatchInstructor", fields: [instructorId], references: [id])

  enrollments  Enrollment[]
  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, status])
  @@index([gender, timeSlot])
}

/* ------------------------------------------------------------------ */
/* Admissions CRM                                                     */
/* ------------------------------------------------------------------ */

model Application {
  id            String   @id @default(cuid())
  /// Human-readable reference given to the applicant, e.g. SPM-2026-0134
  reference     String   @unique
  status        String   @default("NEW")

  fullName   String
  fatherName String?
  gender     String
  cnic       String?
  phone      String
  whatsapp   String?
  email      String?
  city       String?
  education  String?

  /// Course slug at time of applying (kept even if catalogue changes)
  programSlug     String
  preferredSlot   String?
  batchId         String?
  batch           Batch?    @relation(fields: [batchId], references: [id])

  hasComputer Boolean @default(false)
  hasInternet Boolean @default(false)
  howHeard    String?
  motivation  String?

  assignedToId String?
  assignedTo   User?   @relation("AssignedStaff", fields: [assignedToId], references: [id])

  notes      ApplicationNote[]
  enrollment Enrollment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([programSlug])
  @@index([phone])
}

/// CRM activity log — every call, visit and decision recorded.
model ApplicationNote {
  id            String   @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  body          String
  /// Optional status transition captured with the note
  statusFrom    String?
  statusTo      String?
  createdAt     DateTime    @default(now())

  @@index([applicationId, createdAt])
}

/* ------------------------------------------------------------------ */
/* Enrollment & fees                                                  */
/* ------------------------------------------------------------------ */

model Enrollment {
  id            String   @id @default(cuid())
  studentId     String
  student       StudentProfile   @relation(fields: [studentId], references: [id])
  batchId       String
  batch         Batch            @relation(fields: [batchId], references: [id])
  applicationId String?          @unique
  application   Application?     @relation(fields: [applicationId], references: [id])
  status        String   @default("ACTIVE")
  feeMonthly    Int
  feeMonths     Int
  /// Merit or hardship reduction, in rupees per month
  discount      Int              @default(0)
  enrolledAt    DateTime         @default(now())
  completedAt   DateTime?
  /// Completion means the client deliverable shipped — not attendance.
  deliverableShipped Boolean     @default(false)
  /// NOT_STARTED | IN_PROGRESS | SHIPPED — shown on the student portal.
  deliverableStatus  String      @default("NOT_STARTED")

  payments FeePayment[]

  @@unique([studentId, batchId])
  @@index([status])
}

model FeePayment {
  id           String   @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  /// Which instalment, e.g. "Month 2"
  label        String
  amount       Int
  method       String
  status       String   @default("PENDING")
  /// When this instalment should be paid (shown to students / parents).
  dueDate      DateTime?
  reference    String?
  /// Raw gateway payload for audit
  gatewayRef   String?
  proofUrl     String?
  paidAt       DateTime?
  verifiedById String?
  verifiedBy   User?         @relation("VerifiedBy", fields: [verifiedById], references: [id])
  createdAt    DateTime      @default(now())

  @@index([enrollmentId])
  @@index([status])
  @@index([dueDate])
}

/* ------------------------------------------------------------------ */
/* Announcements & inquiries                                          */
/* ------------------------------------------------------------------ */

model Announcement {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  body        String
  audience    String   @default("PUBLIC")
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([audience, isPublished, publishedAt])
}

/// General contact-form messages (routed to admission@ as well)
model Inquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  subject   String?
  message   String
  isHandled Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isHandled, createdAt])
}

/// Published cohort results. The moat — we publish the bad numbers too.
model CohortOutcome {
  id                 String   @id @default(cuid())
  batchLabel         String
  courseName         String
  enrolled           Int
  completed          Int
  dropped            Int
  earnedWithin90Days Int
  earnedNothing      Int
  medianFirstInvoice Int?
  hiredByUs          Int      @default(0)
  publishedAt        DateTime @default(now())
  notes              String?
}
