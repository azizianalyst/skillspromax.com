# ---------- Database (Postgres) ----------
# Neon / Supabase / Hostinger VPS Postgres. Free tier is fine to start.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------- Auth ----------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="https://skillspromax.com"

# ---------- Email (Hostinger SMTP) ----------
# Uses your existing mailboxes. Host/port from Hostinger > Emails > Configuration.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="admission@skillspromax.com"
SMTP_PASSWORD=""

MAIL_FROM="SkillsProMax <admission@skillspromax.com>"
MAIL_ADMISSIONS="admission@skillspromax.com"
MAIL_INFO="info@skillspromax.com"
MAIL_SUPPORT="support@skillspromax.com"

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL="https://skillspromax.com"

# ---------- JazzCash (Phase 4) ----------
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
JAZZCASH_ENV="sandbox"

# ---------- First admin (used by npm run db:seed) ----------
SEED_ADMIN_EMAIL="admin@skillspromax.com"
SEED_ADMIN_PASSWORD="change-this-immediately"
